# MongoDB Atlas URI, including a database name. Server-only.
MONGODB_URI=
# Generate with: openssl rand -base64 48
AUTH_SECRET=
# New uploads use GridFS through MONGODB_URI; no additional storage token is needed.
# Optional: only needed to delete files previously stored in Vercel Blob.
# BLOB_READ_WRITE_TOKEN=
# Stable production origin; override later via admin SEO & Settings.
NEXT_PUBLIC_SITE_URL=
# First admin CLI only. Prefer temporary shell variables; do not commit credentials.
# ADMIN_EMAIL=your-email@example.com
# ADMIN_PASSWORD=your-long-unique-password
